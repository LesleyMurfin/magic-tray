<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MagicMouseTray</AssemblyName>
    <RootNamespace>MagicMouseTray</RootNamespace>
    <!-- PublishSingleFile: dotnet publish -c Release produces a single .exe (M7) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Allows building on non-Windows (e.g. restoring packages) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>magic-mouse.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>Magic Tray</Product>
    <Title>Magic Tray</Title>
    <AssemblyTitle>Magic Tray</AssemblyTitle>
    <Company>Lesley Murfin</Company>
    <Description>Free Magic Utilities alternative for Windows: Apple Magic Mouse and Magic Keyboard battery in the tray, plus user-initiated scroll-driver and keyboard battery install. MIT, no subscription.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MagicMouseTray.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\scripts\capture-state.ps1" Link="capture-state.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\diagnose-driver.ps1" Link="diagnose-driver.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\scripts\mm-bt-stack-snapshot.ps1" Link="mm-bt-stack-snapshot.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

# Internal research / agent state — not part of the public tray app.
#
# `.ai/*` + `!.ai/validators/` instead of a blanket `.ai/`: git cannot
# re-include a path whose parent directory is excluded, so a blanket `.ai/`
# makes `.ai/validators/` unaddable even with a later negation. The PR gates in
# scripts/github.py resolve `.ai/validators/*.py` relative to THIS repo, so the
# validators must be tracked here. See .ai/validators/README.md.
.ai/*
!.ai/validators/
# Bytecode from the PR gates: github.py loads every validator and
# scripts/pr_diagram.py through importlib, which writes __pycache__/ next to
# each source file — under .ai/validators/ AND under scripts/. Repo-wide so
# both are covered at any depth; it sits after the negation above, so it still
# applies inside the re-included .ai/validators/.
__pycache__/
.orca/
.riley-session

bin/
obj/

# Release build output: dotnet publish target and the portable ZIP staging /
# output folder written by scripts/package-release.ps1.
publish/
dist/
*.user
.vs/
*.suo
.idea/

# M13 capture artefacts -- multi-GB binaries archived on disk only.
# Small validation captures (procmon-filter-validation.PML/CSV, single-step
# procmon.PML under 50 MB) ARE committed -- they're cell evidence.
.ai/test-runs/**/*.etl
.ai/test-runs/**/*.ETL
.ai/test-runs/**/*.NGENPDB
.ai/test-runs/**/procmon-pre-reboot-Bootlog*.pml
.ai/test-runs/**/procmon-pre-reboot-Bootlog*.PML
.ai/test-runs/**/procmon-post-reboot.PML
.ai/test-runs/**/procmon-post-reboot*.pml

# Claude Code worktree state -- internal, not project content
.claude/

# Agent-management state -- reviewed separately, not part of cell evidence commits
.ai/learning/
.ai/telemetry/

# Procmon filter typo (superseded by single-dot version; leave for user delete)
scripts/m13-procmon-filter..PMF

# 7-Zip extraction artefacts from Inno Setup probe (PE sections, ~80 MB, transient)
$tmp/

# dotnet test --logger trx output (CI writes it here too, see ci.yml)
TestResults/

# Agent session scratch -- handoff/fix notes, not product code
.run/

# Serena tooling local config
.serena/

# Agent scratch — not product (#66)
.orca/

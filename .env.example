# Stripe Configuration
# Create a Stripe account at https://stripe.com
# Get these keys from Dashboard > Developers > API keys

# Secret API key (sk_live_... or sk_test_...)
STRIPE_API_KEY=sk_test_your_secret_key_here

# Webhook signing secret (whsec_...)
# Get this from Dashboard > Developers > Webhooks > Click the endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Resend Configuration
# Create a Resend account at https://resend.com
# Get the API key from Dashboard > API Keys

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@magictray.app
RESEND_REPLY_TO=support@magictray.app

# Site Configuration
SITE_URL=https://magictray.app/drivers
SITE_NAME=Magic Tray Driver Hub

# Optional: Tax ID for donation receipts
TAX_ID=

# Cloudflare Configuration (for local development with wrangler)
# These are set in wrangler.toml and via `wrangler secret put`
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# KV Namespace ID
# Get from Cloudflare Dashboard > Storage > KV > Create namespace
DONATIONS_KV_NAMESPACE_ID=
